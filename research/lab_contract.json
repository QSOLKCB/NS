{
  "schema_version": "0.2.0",
  "document_type": "qsol_ns_periodic_reference_lab_contract",
  "license": "Apache-2.0",
  "solver_id": "qsol_ns_periodic_pseudospectral_reference",
  "solver_version": "0.1.0",
  "scope": {
    "dimension": 3,
    "domain": "[0,2pi)^3_periodic",
    "boundary_conditions": "periodic_velocity_and_pressure",
    "forcing": "identically_zero",
    "viscosity": "strictly_positive",
    "initial_data_family": "Taylor-Green_vortex",
    "precision": "float64_complex128",
    "spatial_method": "Fourier_pseudospectral_strict_2over3_dealiasing",
    "time_method": "classical_RK4_fixed_step"
  },
  "evidence_policy": {
    "default_claim_level": "exploratory",
    "maximum_automatic_claim_level": "reproduced_numerical",
    "singularity_oriented_promotion_enabled": false,
    "numerical_signature_is_proof": false,
    "solver_failure_is_singularity": false,
    "single_resolution_is_sufficient_for_blowup_claim": false
  },
  "determinism": {
    "randomness": "none",
    "fixed_step_order": true,
    "canonical_json": true,
    "raw_array_format": "npy_allow_pickle_false",
    "replay_expectation": "same_environment_same_inputs_same_output_hashes",
    "cross_platform_bitwise_identity_promised": false
  },
  "baseline_identity_bindings": [
    {"identity_id": "BASE_INCOMPRESSIBILITY", "implementation": "ns_lab.diagnostics.snapshot:divergence_l2"},
    {"identity_id": "BASE_NS_SCALING", "implementation": "ns_lab.diagnostics.velocity_lp_scaling_exponent"},
    {"identity_id": "BASE_SMOOTH_ENERGY_EQUALITY", "implementation": "ns_lab.diagnostics.balance_residuals:energy_balance_residual"},
    {"identity_id": "BASE_VORTICITY_EQUATION", "implementation": "ns_lab.diagnostics.vorticity_equation_residual_l2"},
    {"identity_id": "BASE_SMOOTH_ENSTROPHY_BALANCE", "implementation": "ns_lab.diagnostics.balance_residuals:enstrophy_balance_residual"},
    {"identity_id": "BASE_PRESSURE_POISSON", "implementation": "ns_lab.diagnostics.pressure_poisson_residual_l2"}
  ],
  "precision_referee": {
    "contract": "research/precision_referee_contract.json",
    "available_for_reference_family": true,
    "independent_arithmetic": true,
    "independent_nonlinear_evaluation": true,
    "independent_spatial_discretization": false,
    "scalable_mechanism_search_backend": false
  },
  "required_run_outputs": ["manifest.json", "diagnostics.json", "final_velocity.npy"],
  "required_sensitivity_before_reproduced_numerical": ["rerun_same_inputs", "timestep_comparison", "resolution_comparison"],
  "required_sensitivity_before_any_singularity_oriented_use": ["rerun_same_inputs", "timestep_comparison", "resolution_comparison", "precision_comparison", "competing_numerical_failure_explanation"]
}
