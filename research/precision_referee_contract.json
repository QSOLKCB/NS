{
  "schema_version": "0.1.0",
  "document_type": "qsol_ns_precision_referee_contract",
  "license": "Apache-2.0",
  "backend_id": "mpmath_direct_modal_galerkin_referee",
  "backend_version": "0.1.0",
  "implementation": "ns_lab.precision_referee",
  "comparison_target": "qsol_ns_periodic_pseudospectral_reference",
  "scope": {
    "dimension": 3,
    "domain": "[0,2pi)^3_periodic",
    "boundary_conditions": "periodic_velocity_and_pressure",
    "forcing": "identically_zero",
    "viscosity": "strictly_positive",
    "initial_data_family": "Taylor-Green_vortex",
    "resolution": 8,
    "spatial_system": "same_strict_2over3_retained_Fourier_system_as_reference",
    "nonlinear_evaluation": "direct_modal_convolution_without_FFT",
    "time_method": "classical_RK4_fixed_step",
    "arithmetic": "mpmath_arbitrary_precision"
  },
  "precision_policy": {
    "minimum_dps": 50,
    "default_low_dps": 50,
    "default_high_dps": 80,
    "maximum_supported_dps": 200,
    "precision_ladder_required": true
  },
  "independence_claims": {
    "independent_arithmetic": true,
    "independent_fft_path": true,
    "independent_nonlinear_evaluation": true,
    "independent_spatial_discretization": false,
    "independent_continuum_argument": false
  },
  "evidence_policy": {
    "claim_level": "exploratory",
    "precision_comparison_available_for_reference_family": true,
    "singularity_oriented_promotion_enabled": false,
    "scalable_mechanism_search_backend": false,
    "numerical_agreement_is_proof": false
  },
  "acceptance": {
    "max_reference_modal_abs_difference": 1e-12,
    "max_precision_ladder_modal_abs_difference_decimal": "1e-45"
  },
  "required_nonclaims": [
    "finite_dimensional_agreement_is_not_continuum_proof",
    "precision_agreement_is_not_global_regularity",
    "precision_disagreement_is_not_mathematical_singularity",
    "referee_is_not_an_independent_spatial_discretization",
    "low_resolution_agreement_does_not_establish_high_resolution_agreement"
  ]
}
