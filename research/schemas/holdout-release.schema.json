{
  "$id": "https://github.com/QSOLKCB/NS/blob/main/research/schemas/holdout-release.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {"minLength": 1, "type": "string"},
    "candidate_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "type": "string"},
    "candidate_snapshot_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "holdout_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "type": "string"},
    "holdout_payload_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "materialization_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "type": "string"},
    "release_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "type": "string"},
    "released_at_utc": {"format": "date-time", "type": "string"},
    "source_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
  },
  "required": ["release_id", "materialization_id", "holdout_id", "candidate_id", "candidate_snapshot_sha256", "holdout_payload_sha256", "actor", "source_commit", "released_at_utc"],
  "title": "QSOL Crucible Holdout Release Receipt",
  "type": "object"
}
