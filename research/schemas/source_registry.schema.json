{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS/blob/main/research/schemas/source_registry.schema.json",
  "title": "QSOL NS source registry",
  "type": "object",
  "required": ["schema_version", "document_type", "license", "authority_rule", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "qsol_ns_source_registry"},
    "license": {"const": "Apache-2.0"},
    "authority_rule": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "authority_class", "authors", "year", "title", "publisher_or_venue", "doi", "url", "role", "notes"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "authority_class": {"enum": ["official_problem_statement", "primary_research", "secondary_discovery"]},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "year": {"type": "integer", "minimum": 1800, "maximum": 2100},
        "title": {"type": "string", "minLength": 1},
        "publisher_or_venue": {"type": "string", "minLength": 1},
        "doi": {"type": ["string", "null"]},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[A-Za-z0-9.-]+(?:/|$)"
        },
        "role": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
