{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS/blob/main/research/schemas/baseline_identities.schema.json",
  "title": "QSOL NS baseline identity registry",
  "type": "object",
  "required": ["schema_version", "document_type", "license", "policy", "identities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "qsol_ns_baseline_identity_registry"},
    "license": {"const": "Apache-2.0"},
    "policy": {"type": "string", "minLength": 1},
    "identities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["identity_id", "name", "statement", "assumptions", "phase2_diagnostic"],
      "properties": {
        "identity_id": {"type": "string", "pattern": "^BASE_[A-Z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "phase2_diagnostic": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
