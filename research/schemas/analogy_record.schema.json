{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS/blob/main/research/schemas/analogy_record.schema.json",
  "title": "QSOL Analogy Record",
  "type": "object",
  "required": [
    "analogy_id",
    "source_domain",
    "target_domain",
    "mapping_class",
    "shared_structure",
    "assumptions",
    "known_differences",
    "allowed_uses",
    "forbidden_inferences",
    "provenance_ref"
  ],
  "properties": {
    "analogy_id": {"type": "string", "minLength": 1},
    "source_domain": {"type": "string", "minLength": 1},
    "target_domain": {"type": "string", "minLength": 1},
    "mapping_class": {"enum": ["exact_correspondence", "operator_correspondence", "structural_analogy", "heuristic_analogy", "visual_resemblance", "explicit_non_correspondence"]},
    "shared_structure": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "known_differences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allowed_uses": {"type": "array", "minItems": 1, "items": {"enum": ["candidate_generation", "negative_control"]}, "uniqueItems": true},
    "forbidden_inferences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "provenance_ref": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
