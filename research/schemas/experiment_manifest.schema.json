{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS/blob/main/research/schemas/experiment_manifest.schema.json",
  "title": "QSOL NS experiment manifest",
  "type": "object",
  "required": ["experiment_id", "source_commit", "created_at_utc", "operator_or_agent", "purpose", "hypothesis", "claim_level", "spatial_domain", "boundary_conditions", "initial_velocity_field_definition", "divergence_free_admissibility", "viscosity", "forcing", "scaling_convention", "measured_solution_quantity", "solver", "solver_version", "spatial_discretization", "time_integrator", "time_step_policy", "resolution", "precision", "tolerances", "filtering_regularization", "interpolation_remeshing", "random_seed_or_null", "operating_system_or_container_identity", "compiler_or_interpreter", "dependency_lock_or_exact_versions", "numerics_relevant_hardware_features", "thread_or_process_count", "input_hashes", "output_hashes", "diagnostics", "termination_reason", "warnings_or_errors", "wall_clock_independent_step_counts", "raw_outputs_or_content_addressed_pointer"],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "operator_or_agent": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "claim_level": {"enum": ["exploratory", "reproduced_numerical"]},
    "spatial_domain": {"type": "string", "minLength": 1},
    "boundary_conditions": {"type": "string", "minLength": 1},
    "initial_velocity_field_definition": {"type": "string", "minLength": 1},
    "divergence_free_admissibility": {"type": "string", "minLength": 1},
    "viscosity": {"type": "number", "exclusiveMinimum": 0},
    "forcing": {"type": "string", "minLength": 1},
    "scaling_convention": {"type": "string", "minLength": 1},
    "measured_solution_quantity": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "solver": {"type": "string", "minLength": 1},
    "solver_version": {"type": "string", "minLength": 1},
    "spatial_discretization": {"type": "string", "minLength": 1},
    "time_integrator": {"type": "string", "minLength": 1},
    "time_step_policy": {"type": "string", "minLength": 1},
    "resolution": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 6}},
    "precision": {"type": "string", "minLength": 1},
    "tolerances": {"type": "object"},
    "filtering_regularization": {"type": "string", "minLength": 1},
    "interpolation_remeshing": {"type": ["string", "null"]},
    "random_seed_or_null": {"type": ["integer", "string", "null"]},
    "operating_system_or_container_identity": {"type": "string", "minLength": 1},
    "compiler_or_interpreter": {"type": "string", "minLength": 1},
    "dependency_lock_or_exact_versions": {"type": "object", "minProperties": 1},
    "numerics_relevant_hardware_features": {"type": "string", "minLength": 1},
    "thread_or_process_count": {"type": "integer", "minimum": 1},
    "input_hashes": {"type": "object"},
    "output_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "diagnostics": {"type": "object", "minProperties": 1},
    "termination_reason": {"type": "string", "minLength": 1},
    "warnings_or_errors": {"type": "array", "items": {"type": "string"}},
    "wall_clock_independent_step_counts": {"type": "integer", "minimum": 0},
    "raw_outputs_or_content_addressed_pointer": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
