{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS/blob/main/research/schemas/ml_candidate_proposal.schema.json",
  "title": "QSOL ML candidate proposal",
  "type": "object",
  "required": [
    "proposal_id",
    "target_hypothesis",
    "precise_statement",
    "motivation",
    "assumptions",
    "claimed_dependencies",
    "suggested_tests",
    "possible_failure_modes",
    "analogy_sources",
    "parent_candidate_ids",
    "generator_notes"
  ],
  "properties": {
    "proposal_id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "target_hypothesis": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "precise_statement": {"type": "string", "minLength": 1},
    "motivation": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claimed_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "suggested_tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "possible_failure_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "analogy_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "parent_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "generator_notes": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
