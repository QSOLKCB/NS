{
  "$id": "https://github.com/QSOLKCB/NS/blob/main/research/schemas/holdout-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "domain_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "type": "string"},
    "evaluator_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "type": "string"},
    "evaluator_version": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "type": "string"},
    "holdout_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "type": "string"},
    "leakage_sentinel_sha256": {"items": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "type": "array", "uniqueItems": true},
    "negative_control_ids": {"items": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "type": "string"}, "type": "array", "uniqueItems": true},
    "payload_media_type": {"const": "application/json"},
    "payload_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "payload_size_bytes": {"minimum": 1, "type": "integer"},
    "sealed_at_utc": {"format": "date-time", "type": "string"},
    "source_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
  },
  "required": ["holdout_id", "domain_id", "evaluator_id", "evaluator_version", "payload_sha256", "payload_size_bytes", "leakage_sentinel_sha256", "negative_control_ids", "source_commit", "sealed_at_utc", "payload_media_type"],
  "title": "QSOL Crucible Holdout Manifest",
  "type": "object"
}
