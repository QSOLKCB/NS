{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/QSOLKCB/NS/blob/main/research/schemas/ns_candidate_transform_adapter.schema.json",
  "type":"object",
  "required":["schema_version","document_type","license","adapter_version","transform_contract","domain_id","hypothesis_set_id","allowed_target_hypotheses","operator_bindings","registry_bindings","context_policy","epistemic_authority"],
