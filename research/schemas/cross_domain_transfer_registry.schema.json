{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS/blob/main/research/schemas/cross_domain_transfer_registry.schema.json",
  "title": "QSOL Cross-Domain Transfer Registry",
  "type": "object",
  "required": ["schema_version", "document_type", "license", "registry_version", "source_material", "records"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "document_type": {"const": "qsol_cross_domain_transfer_registry"},
    "license": {"const": "Apache-2.0"},
    "registry_version": {"const": "0.1.0"},
    "source_material": {
      "type": "object",
      "required": ["kind", "name", "sha256", "authority"],
      "properties": {
        "kind": {"const": "user_supplied_technical_reference"},
        "name": {"const": "pr6.md"},
        "sha256": {"const": "2bb9bc6f44af2dda571c70cc925196b29e02fc14cc50aef84fc69fc41c761042"},
        "authority": {"const": "design_input_not_domain_authority"}
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["analogy_id", "source_domain", "target_domain", "mapping_class", "shared_structure", "assumptions", "known_differences", "allowed_uses", "forbidden_inferences", "provenance_ref"],
        "properties": {
          "analogy_id": {"type": "string", "minLength": 1},
          "source_domain": {"type": "string", "minLength": 1},
          "target_domain": {"type": "string", "minLength": 1},
          "mapping_class": {"enum": ["exact_correspondence", "operator_correspondence", "structural_analogy", "heuristic_analogy", "visual_resemblance", "explicit_non_correspondence"]},
          "shared_structure": {"type": "string", "minLength": 1},
          "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "known_differences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "allowed_uses": {"type": "array", "minItems": 1, "items": {"enum": ["candidate_generation", "negative_control"]}, "uniqueItems": true},
          "forbidden_inferences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "provenance_ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
