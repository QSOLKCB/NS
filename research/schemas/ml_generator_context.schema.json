{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS/blob/main/research/schemas/ml_generator_context.schema.json",
  "title": "QSOL ML generator context packet",
  "type": "object",
  "required": [
    "domain_id",
    "hypothesis_set_id",
    "target_hypotheses",
    "theorem_ids",
    "proof_barrier_ids",
    "frontier_candidate_ids",
    "failure_lessons",
    "permitted_analogy_ids",
    "ledger_event_count",
    "ledger_head_event_sha256",
    "source_commit",
    "task"
  ],
  "properties": {
    "domain_id": {"type": "string", "minLength": 1},
    "hypothesis_set_id": {"type": "string", "minLength": 1},
    "target_hypotheses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "theorem_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "proof_barrier_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "frontier_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "failure_lessons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "permitted_analogy_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "ledger_event_count": {"type": "integer", "minimum": 0},
    "ledger_head_event_sha256": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "task": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
