{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS/blob/main/research/schemas/theorem_registry.schema.json",
  "title": "QSOL NS theorem registry",
  "type": "object",
  "required": ["schema_version", "document_type", "license", "registry_policy", "theorems"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "qsol_ns_theorem_registry"},
    "license": {"const": "Apache-2.0"},
    "registry_policy": {
      "type": "object",
      "required": ["source_authority", "official_target", "default_verification_status", "novelty_claim_default", "solution_claim_default"],
      "properties": {
        "source_authority": {"const": "research/source_registry.json"},
        "official_target": {"const": "research/clay_target.json"},
        "default_verification_status": {"const": "source_checked_summary"},
        "novelty_claim_default": {"const": false},
        "solution_claim_default": {"const": false}
      },
      "additionalProperties": false
    },
    "theorems": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/theorem"}}
  },
  "$defs": {
    "theorem": {
      "type": "object",
      "required": ["theorem_id", "title", "source_ids", "year", "category", "domain", "hypotheses_summary", "conclusion_summary", "limitations", "relation_to_clay", "supports_tracks", "blocks_blowup_scenarios", "verification_status", "formalized", "novelty_claim", "solves_clay"],
      "properties": {
        "theorem_id": {"type": "string", "pattern": "^KNOWN_[A-Z0-9_]+$"},
        "title": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}},
        "year": {"type": "integer", "minimum": 1800, "maximum": 2100},
        "category": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "hypotheses_summary": {"type": "string", "minLength": 1},
        "conclusion_summary": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "relation_to_clay": {"type": "string", "minLength": 1},
        "supports_tracks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["global_regularity", "breakdown"]}},
        "blocks_blowup_scenarios": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "verification_status": {"const": "source_checked_summary"},
        "formalized": {"type": "boolean"},
        "novelty_claim": {"const": false},
        "solves_clay": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
