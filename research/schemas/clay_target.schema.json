{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS/blob/main/research/schemas/clay_target.schema.json",
  "title": "QSOL NS Clay target",
  "type": "object",
  "required": ["schema_version", "document_type", "license", "authority", "shared_equation_scope", "official_formulations", "errata", "machine_invariants"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_type": {"const": "qsol_ns_clay_target"},
    "license": {"const": "Apache-2.0"},
    "authority": {
      "type": "object",
      "required": ["name", "problem_title", "author", "landing_page", "official_pdf", "retrieved_date"],
      "properties": {
        "name": {"const": "Clay Mathematics Institute"},
        "problem_title": {"type": "string", "minLength": 1},
        "author": {"const": "Charles L. Fefferman"},
        "landing_page": {"type": "string", "format": "uri"},
        "official_pdf": {"type": "string", "format": "uri"},
        "retrieved_date": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "shared_equation_scope": {
      "type": "object",
      "required": ["dimension", "viscosity", "incompressible", "unknowns", "equations"],
      "properties": {
        "dimension": {"const": 3},
        "viscosity": {"const": "nu > 0"},
        "incompressible": {"const": true},
        "unknowns": {"const": ["u", "p"]},
        "equations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "official_formulations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/formulationA"},
        {"$ref": "#/$defs/formulationB"},
        {"$ref": "#/$defs/formulationC"},
        {"$ref": "#/$defs/formulationD"}
      ],
      "items": false
    },
    "errata": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/erratum"}},
    "machine_invariants": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "formulationBase": {
      "type": "object",
      "required": ["id", "direction", "domain", "initial_data", "forcing", "required_conclusion", "zero_force_allowed", "zero_force_required"],
      "properties": {
        "id": {"type": "string"},
        "direction": {"enum": ["global_smoothness", "breakdown"]},
        "domain": {"enum": ["R^3", "R^3/Z^3"]},
        "initial_data": {"type": "string", "minLength": 1},
        "forcing": {"type": "string", "minLength": 1},
        "required_conclusion": {"type": "string", "minLength": 1},
        "zero_force_allowed": {"type": "boolean"},
        "zero_force_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "formulationA": {"allOf": [{"$ref": "#/$defs/formulationBase"}, {"properties": {"id": {"const": "A"}, "direction": {"const": "global_smoothness"}, "domain": {"const": "R^3"}, "zero_force_allowed": {"const": true}, "zero_force_required": {"const": true}}}]},
    "formulationB": {"allOf": [{"$ref": "#/$defs/formulationBase"}, {"properties": {"id": {"const": "B"}, "direction": {"const": "global_smoothness"}, "domain": {"const": "R^3/Z^3"}, "zero_force_allowed": {"const": true}, "zero_force_required": {"const": true}}}]},
    "formulationC": {"allOf": [{"$ref": "#/$defs/formulationBase"}, {"properties": {"id": {"const": "C"}, "direction": {"const": "breakdown"}, "domain": {"const": "R^3"}, "zero_force_allowed": {"const": true}, "zero_force_required": {"const": false}}}]},
    "formulationD": {"allOf": [{"$ref": "#/$defs/formulationBase"}, {"properties": {"id": {"const": "D"}, "direction": {"const": "breakdown"}, "domain": {"const": "R^3/Z^3"}, "zero_force_allowed": {"const": true}, "zero_force_required": {"const": false}}}]},
    "erratum": {
      "type": "object",
      "required": ["scope", "statement", "source"],
      "properties": {"scope": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
