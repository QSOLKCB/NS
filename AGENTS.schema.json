{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/NS/blob/main/AGENTS.schema.json",
  "title": "QSOL NS Agent Contract",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "serialization",
    "repository",
    "default_branch",
    "human_operator",
    "agent_boot_sequence",
    "branch_policy",
    "research_invariants",
    "claim_levels",
    "claim_promotion",
    "literature_boundary_policy",
    "experiment_requirements",
    "proof_requirements",
    "licensing",
    "file_policy",
    "language_policy",
    "review_policy",
    "completion_contract"
  ],
  "properties": {
    "schema_version": {"const": "1.3.0"},
    "document_type": {"const": "qsol_ns_agent_contract"},
    "serialization": {"const": "json"},
    "repository": {"const": "QSOLKCB/NS"},
    "default_branch": {"const": "main"},
    "human_operator": {
      "const": {
        "role": "final_authority",
        "required_for": [
          "public_solution_claim",
          "license_scope_change",
          "history_rewrite",
          "deletion_of_evidentiary_artifacts",
          "release_or_archive_publication"
        ]
      }
    },
    "agent_boot_sequence": {
      "const": [
        "parse_AGENTS_md_as_JSON",
        "validate_against_AGENTS_schema_json",
        "run_tools_validate_boundary_map_py",
        "run_tools_validate_lab_contract_py",
        "run_tools_validate_precision_referee_py",
        "read_README_md",
        "read_docs_PROBLEM_STATEMENT_md",
        "read_research_clay_target_json",
        "read_research_source_registry_json",
        "read_research_theorem_registry_json",
        "read_research_proof_barriers_json",
        "read_research_baseline_identities_json",
        "read_research_lab_contract_json",
        "read_research_precision_referee_contract_json",
        "read_docs_CLAIM_LEVELS_md",
        "read_docs_EXPERIMENT_CONTRACT_md",
        "read_docs_REPRODUCIBILITY_md",
        "read_docs_PUBLICATION_GATE_md",
        "inspect_current_branch_and_head_commit",
        "inspect_worktree_or_target_diff_before_mutation"
      ]
    },
    "branch_policy": {
      "const": {
        "direct_main_write": false,
        "agent_branch_prefix": "agent/",
        "default_delivery": "draft_pull_request",
        "force_push": false,
        "history_rewrite": false
      }
    },
    "research_invariants": {
      "const": [
        "numerical_blowup_signature_is_not_proof_of_blowup",
        "absence_of_observed_blowup_is_not_proof_of_global_regularity",
        "formal_verification_is_not_physical_truth",
        "candidate_lemma_is_not_verified_theorem",
        "private_experiment_is_not_public_claim",
        "official_clay_problem_is_not_redefined_by_repository_text",
        "negative_and_null_results_are_preserved",
        "solver_failure_is_not_mathematical_singularity",
        "floating_point_overflow_is_not_mathematical_singularity",
        "resolution_instability_is_not_mathematical_singularity",
        "precision_agreement_is_not_continuum_proof",
        "finite_dimensional_agreement_is_not_global_regularity",
        "precision_referee_is_not_independent_spatial_discretization",
        "claim_status_must_never_exceed_evidence_status"
      ]
    },
    "claim_levels": {
      "const": [
        "exploratory",
        "reproduced_numerical",
        "candidate_lemma",
        "proved_lemma",
        "externally_checked_theorem",
        "publication_candidate",
        "public_solution_claim"
      ]
    },
    "claim_promotion": {
      "const": {
        "upward_promotion_is_monotonic": true,
        "automatic_promotion_allowed": false,
        "corrective_downgrades_allowed": true,
        "downgrade_reason_must_be_preserved": true,
        "public_solution_claim_requires_human_operator": true,
        "public_solution_claim_requires_completed_external_mathematical_review": true,
        "numerics_can_promote_to": "reproduced_numerical",
        "formal_checker_can_promote_to": "proved_lemma",
        "formal_checker_scope": "encoded_statement_only"
      }
    },
    "literature_boundary_policy": {
      "const": {
        "canonical_clay_target": "research/clay_target.json",
        "source_registry": "research/source_registry.json",
        "theorem_registry": "research/theorem_registry.json",
        "proof_barrier_registry": "research/proof_barriers.json",
        "baseline_identity_registry": "research/baseline_identities.json",
        "boundary_validator": "tools/validate_boundary_map.py",
        "theorem_authority_requires_primary_or_official_source": true,
        "secondary_sources_may_discover_but_not_authorize": true,
        "hypothesis_weakening_without_proof_forbidden": true,
        "conclusion_strengthening_without_proof_forbidden": true,
        "domain_or_forcing_substitution_without_bridge_forbidden": true,
        "novelty_claim_requires_registry_and_literature_update": true
      }
    },
    "experiment_requirements": {
      "const": {
        "canonical_field_definition": "AGENTS.md#experiment_requirements.required_fields",
        "required_fields": [
          "experiment_id",
          "source_commit",
          "created_at_utc",
          "operator_or_agent",
          "purpose",
          "hypothesis",
          "claim_level",
          "spatial_domain",
          "boundary_conditions",
          "initial_velocity_field_definition",
          "divergence_free_admissibility",
          "viscosity",
          "forcing",
          "scaling_convention",
          "measured_solution_quantity",
          "solver",
          "solver_version",
          "spatial_discretization",
          "time_integrator",
          "time_step_policy",
          "resolution",
          "precision",
          "tolerances",
          "filtering_regularization",
          "interpolation_remeshing",
          "random_seed_or_null",
          "operating_system_or_container_identity",
          "compiler_or_interpreter",
          "dependency_lock_or_exact_versions",
          "numerics_relevant_hardware_features",
          "thread_or_process_count",
          "input_hashes",
          "output_hashes",
          "diagnostics",
          "termination_reason",
          "warnings_or_errors",
          "wall_clock_independent_step_counts",
          "raw_outputs_or_content_addressed_pointer"
        ],
        "singularity_run_required_fields": [
          "convergence_resolution_behavior",
          "precision_sensitivity",
          "conservation_balance_residuals",
          "timestep_sensitivity",
          "competing_numerical_failure_explanation"
        ],
        "raw_outputs_preserved": true,
        "failed_runs_preserved_when_informative": true,
        "silent_parameter_changes_forbidden": true
      }
    },
    "proof_requirements": {
      "const": {
        "explicit_hypotheses": true,
        "explicit_domain": true,
        "explicit_regularization_or_approximation": true,
        "external_theorem_dependencies_cited": true,
        "formal_artifact_required_fields": [
          "prover",
          "prover_version",
          "dependency_lock_identity",
          "theorem_fully_qualified_name",
          "encoded_statement",
          "assumptions_and_axioms_used",
          "source_commit",
          "build_command",
          "successful_ci_or_run_identity_or_null",
          "correspondence_note"
        ],
        "proof_gap_markers_forbidden_in_verified_status": [
          "sorry",
          "admit",
          "assume_without_source",
          "numerically_obvious",
          "physically_obvious"
        ]
      }
    },
    "licensing": {
      "const": {
        "software_spdx": "Apache-2.0",
        "machine_policy_spdx": "Apache-2.0",
        "research_prose_spdx": "CC-BY-4.0",
        "license_scope_authority": "LICENSES.md",
        "license_mutation_requires_human_operator": true
      }
    },
    "file_policy": {
      "const": {
        "immutable_without_explicit_reason": [
          "LICENSE",
          "LICENSES.md",
          "NOTICE",
          "CITATION.cff",
          "AGENTS.md",
          "AGENTS.schema.json"
        ],
        "generated_artifacts_must_record_generator": true,
        "binary_results_require_manifest_entry": true,
        "secrets_forbidden": true
      }
    },
    "language_policy": {
      "const": {
        "solution_language_forbidden_unless_status_is_public_solution_claim": [
          "solved",
          "solution established",
          "millennium problem resolved",
          "proof complete"
        ],
        "required_uncertainty_label_for_exploratory_results": true
      }
    },
    "review_policy": {
      "const": {
        "adversarial_review": true,
        "check_prior_art_before_novelty_claim": true,
        "check_scaling_and_units": true,
        "check_boundary_and_initial_conditions": true,
        "check_discrete_continuum_gap": true,
        "check_roundoff_and_resolution_sensitivity": true,
        "check_circular_reasoning": true,
        "check_hidden_regularization": true
      }
    },
    "completion_contract": {
      "const": {
        "summarize_changed_files": true,
        "report_validation_performed": true,
        "report_unresolved_risks": true,
        "report_exact_head_commit": true,
        "never_claim_background_work": true
      }
    }
  },
  "additionalProperties": false
}
